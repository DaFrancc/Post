                "pattern": "^[0-9a-f]{32}$"
              },
              "message_id": {
                "description": "The message.",
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              }
            },
            "required": [
              "type",
              "conversation",
              "message_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "Someone's presence changed.",
            "type": "object",
            "properties": {
              "type": {
                "const": "presence"
              },
              "username": {
                "description": "Whose.",
                "type": "string"
              },
              "presence": {
                "description": "What it is now.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Presence"
                  }
                ]
              },
              "until_ms": {
                "description": "Until when, if they set an end (Unix ms).",
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "format": "unix-ms"
                  },
