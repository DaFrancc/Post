                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "username",
              "presence"
            ],
            "additionalProperties": false
          },
          {
            "description": "This account's devices changed.",
            "type": "object",
            "properties": {
              "type": {
                "const": "devices_changed"
              }
            },
            "required": [
              "type"
