                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "mentions": {
            "description": "Who it mentions.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versions": {
            "description": "Earlier versions of it, newest first.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "presence": {
            "description": "Its sender's presence when it arrived.",
            "allOf": [
