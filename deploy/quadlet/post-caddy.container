[Unit]
Description=Post TLS front end (Caddy)

[Container]
ContainerName=post-caddy
Image=docker.io/library/caddy:2
Pod=post.pod
Volume=%h/.config/post/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=post-caddy-data.volume:/data
Volume=post-caddy-config.volume:/config
Environment=POST_DOMAIN=chat.example.org
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
