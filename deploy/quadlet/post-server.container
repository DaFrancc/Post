[Unit]
Description=Post server (postd)

[Container]
ContainerName=post-server
Image=localhost/postd:latest
Pod=post.pod
Volume=post-data.volume:/var/lib/post
# The database key, from `podman secret create post-db-key ...`.
Secret=post-db-key,type=mount,target=/run/secrets/post-db-key,uid=65532,gid=65532,mode=0400
# The domain and every other setting: deploy/post.env, copied there.
EnvironmentFile=%h/.config/post/post.env
Environment=POST_LISTEN=127.0.0.1:8080
# Calls, through post-livekit.container, when post.env sets POST_LIVEKIT_URL.
Environment=POST_LIVEKIT_SECRET_FILE=/run/secrets/post-livekit-secret
Secret=post-livekit-keys,type=mount,target=/run/secrets/post-livekit-secret,uid=65532,gid=65532,mode=0400
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
# `systemctl --user reload post-server`: look for new app releases now.
ExecReload=/usr/bin/podman kill --signal HUP post-server

[Install]
WantedBy=default.target
