[Unit]
Description=Postern TLS front end (Caddy)

[Container]
ContainerName=postern-caddy
Image=docker.io/library/caddy:2
Pod=postern.pod
Volume=%h/.config/postern/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=postern-caddy-data.volume:/data
Volume=postern-caddy-config.volume:/config
Environment=POSTERN_DOMAIN=chat.example.org
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
