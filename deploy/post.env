# A Post server's settings, read by postd and Caddy (deploy/README.md).
# deploy/server.sh install writes this to ~/.config/post/post.env with your
# domain filled in, and leaves it alone afterwards: your changes stay.
# Restart to apply them: systemctl restart post-pod (with --user for a
# rootless install).

# The server's domain. It is bound into every account and cannot change.
POST_DOMAIN=chat.example.org

# Calls, through post-livekit.container: delete this line to offer none.
POST_LIVEKIT_URL=wss://chat.example.org/livekit
# The most people in one call, and the most each may send (kbit/s). Apps
# step their quality down to fit.
#POST_CALL_MAX_PARTICIPANTS=25
#POST_CALL_MAX_BITRATE_KBPS=2500

# Profile pictures and banners, stored encrypted beside the database: the
# most room they may take together, in MB. Each is at most half a megabyte.
#POST_BLOB_STORE_MB=4096

# App updates: what the server does by itself when a release comes out.
#POST_RELEASES_CHECK=true
#POST_RELEASES_DOWNLOAD=true
#POST_RELEASES_LIVE_WHILE_RUNNING=false
#POST_RELEASES_LIVE_ON_START=true
# Another repository to fetch releases from (owner/repo); empty for none.
#POST_RELEASES_FROM=DaFrancc/Post
