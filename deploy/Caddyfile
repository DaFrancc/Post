# Caddy in front of posternd (design section 12).
#
# Caddy gets and renews the TLS certificate. Built with Go 1.24 or later, it
# negotiates the hybrid post-quantum group X25519MLKEM768 by default.
#
# Caddy writes no access log unless a `log` directive asks for one; keep it
# that way, so client IP addresses are not recorded (design section 3).
{$POSTERN_DOMAIN} {
	# posternd shares the pod's network namespace and listens on localhost only.
	reverse_proxy 127.0.0.1:8080
}
